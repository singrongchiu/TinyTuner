# A 24 B 23 C 22 D 21 E 17 F 16 G 15
LOCATE COMP "io_out[6]" SITE "C16";
IOBUF  PORT "io_out[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "io_out[5]" SITE "B17";
IOBUF  PORT "io_out[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "io_out[4]" SITE "B15";
IOBUF  PORT "io_out[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "io_out[3]" SITE "C18";
IOBUF  PORT "io_out[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "io_out[2]" SITE "L16";
IOBUF  PORT "io_out[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "io_out[1]" SITE "N16";
IOBUF  PORT "io_out[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "io_out[0]" SITE "N17";
IOBUF  PORT "io_out[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

## CAT
LOCATE COMP "" SITE "U18";
IOBUF  PORT "" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;

## SEL
LOCATE COMP "" SITE "U17";
IOBUF  PORT "" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "io_out[7]" SITE "P16";
IOBUF  PORT "io_out[7]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "io_in[0]" SITE "M17";
IOBUF  PORT "io_in[0]" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

